---
import Layout from '../components/Layout.astro';
---

<Layout title="Portfolio" description="Placeholder portfolio for a computer science student.">
  <header class="hero section--dark text-center">
    <div class="container">
      <h1>Portfolio</h1>
      <p class="muted" style="max-width: var(--text-max); margin: 0 auto var(--space-6); font-size: var(--font-size-lg)">
        Computer science student focused on software engineering, networking, data science, machine learning, and AI.
      </p>
    </div>
  </header>

  <section class="section--light" id="work">
    <div class="container">
      <h2>Featured Work</h2>
      <p class="muted">Placeholder project cards go here. Real content added once the site is running.</p>
    </div>
  </section>
</Layout>
